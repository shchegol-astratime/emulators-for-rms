# Образы в Docker Hub
RMS_WMS_EMULATOR_IMAGE=shchegolastratime/rms-wms-emulator:0.1.0
RMS_DARKSTOREDB_EMULATOR_IMAGE=shchegolastratime/rms-darkstoredb-emulator:0.1.0
RMS_GANTRY_EMULATOR_IMAGE=shchegolastratime/rms-gantry-emulator:0.1.1

# WMS: порт API и веб-интерфейса (внутри контейнера и на хосте)
WMS_PORT=8180

# DarkstoreDB: порт API и веб-интерфейса (внутри контейнера и на хосте)
DARKSTOREDB_PORT=8580
# DarkstoreDB: адрес роботов, который отдаётся RMS; RMS в Docker не видит localhost хоста
DARKSTOREDB_ROBOT_HOST=host.docker.internal

# Gantry: порт веб-интерфейса (внутри контейнера и на хосте)
GANTRY_PORT=8280
# Gantry: роботы при старте, ID:PORT через пробел
GANTRY_ROBOTS=1:50051 2:50052 3:50053
# Gantry: диапазон gRPC-портов, публикуемых на хосте; порты роботов из GANTRY_ROBOTS и добавленных в интерфейсе должны в него входить
GANTRY_GRPC_PORTS=50051-50060
